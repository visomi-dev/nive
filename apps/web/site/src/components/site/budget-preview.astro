---
import type { MarketingCopy } from '../../content/marketing-copy';
import Text from '../text.astro';

type Props = { copy: MarketingCopy['preview'] };
const { copy } = Astro.props;
const widths = ['w-[72%]', 'w-[48%]', 'w-[32%]'];
---

<figure class="relative mx-auto w-full max-w-lg min-w-0" aria-labelledby="budget-preview-caption">
  <div
    class="absolute -inset-3 -z-10 rounded-[3rem] bg-accent/40 rotate-3 md:-inset-5 dark:bg-accent/10"
    aria-hidden="true"
  ></div>

  <div class="rounded-[2rem] bg-surface p-6 shadow-[0_32px_64px_-12px_rgb(9_9_11_/_0.08)] sm:p-8">
    <div class="flex items-center justify-between gap-3">
      <span class="font-heading text-lg font-extrabold tracking-tight">
        nive<span class="text-brand">.</span>
      </span>

      <span class="rounded-full bg-raised px-3 py-1.5 text-xs font-semibold">{copy.space}</span>
    </div>

    <div class="mt-7 rounded-3xl bg-feature p-6 text-white">
      <Text ui-size="xs" tone="inherit" weight="semibold" class="marketing-short-text text-white/75!">
        {copy.period}
      </Text>

      <Text ui-size="sm" tone="inherit" class="marketing-feature-copy mt-5 leading-5!">
        {copy.remaining}
      </Text>

      <Text
        ui-size="inherit"
        tone="inherit"
        weight="semibold"
        class="mt-1 font-heading text-4xl tracking-tight tabular-nums sm:text-5xl"
      >
        $8,450<span class="text-2xl text-white/70">.00</span>
      </Text>

      <div class="mt-5 h-1.5 overflow-hidden rounded-full bg-white/15" aria-hidden="true">
        <div class="h-full w-[65%] rounded-full bg-accent"></div>
      </div>

      <dl class="mt-4 flex flex-wrap justify-between gap-4 text-xs">
        <div>
          <dt class="text-white/75">{copy.planned}</dt>

          <dd class="mt-1 font-semibold tabular-nums">$24,000.00</dd>
        </div>

        <div class="text-right">
          <dt class="text-white/75">{copy.spent}</dt>

          <dd class="mt-1 font-semibold tabular-nums">$15,550.00</dd>
        </div>
      </dl>
    </div>

    <div class="mt-6 grid gap-4">
      {copy.categories.map((category, index) => (
        <div class="flex items-center gap-3">
          <span
            class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-raised text-sm text-brand"
            aria-hidden="true"
          >
            {['↗', '⌂', '✳'][index]}
          </span>

          <div class="min-w-0 flex-1">
            <Text ui-size="sm" tone="inherit" weight="semibold" class="marketing-copy leading-5!">
              {category}
            </Text>

            <div class="mt-2 h-1 rounded-full bg-raised" aria-hidden="true">
              <div class:list={['h-full rounded-full bg-brand/60', widths[index]]}></div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <Text
    as="figcaption"
    id="budget-preview-caption"
    ui-size="xs"
    tone="inherit"
    class="marketing-short-text marketing-muted mt-5 text-center"
  >
    {copy.label}
  </Text>
</figure>
